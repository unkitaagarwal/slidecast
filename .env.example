# --- Gemini (text + Nano Banana image generation) ---
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

#--for generating the actual food images via gpt-image-1 model
OPENAI_API_KEY=OPEN_API_KEY

# Optional: override image model (default gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_VERBOSE=1   # log every fallback attempt (404s are hidden by default)
# GEMINI_TEXT_TIMEOUT=300  # seconds (default 180) for compilation text generation
# GEMINI_IMAGE_TIMEOUT=90  # seconds (default 90) per image API call

# --- Postiz (multi-account TikTok / Instagram scheduling) ---
POSTIZ_API_KEY=YOUR_POSTIZ_KEY_HERE
POSTIZ_API_BASE=https://api.postiz.com/public/v1

# --- TikTok Display API (owned-account tracking, PKCE OAuth) ---
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_REDIRECT_URI=http://localhost:8765/auth/tiktok/callback

# --- Stripe (subscriptions) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=https://theslidecast.com/success
STRIPE_CANCEL_URL=https://theslidecast.com/pricing

# --- Optional: webapp config ---
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8765
