# --- Gemini (text + Nano Banana image generation) ---
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# --- Postiz (multi-account TikTok / Instagram scheduling) ---
POSTIZ_API_KEY=YOUR_POSTIZ_KEY_HERE
POSTIZ_API_BASE=https://api.postiz.com/public/v1

# --- TikTok Display API (owned-account tracking, PKCE OAuth) ---
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_REDIRECT_URI=http://localhost:8765/auth/tiktok/callback

# --- Optional: webapp config ---
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8765
